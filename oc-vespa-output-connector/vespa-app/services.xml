<services version="1.0" xmlns:deploy="vespa" xmlns:preprocess="properties">

    <container id="default" version="1.0">
        <document-api/>
        <search/>
        <nodes>
            <node hostalias="node1"/>
        </nodes>
    </container>

    <content id="opencrawling_content" version="1.0">
        <min-redundancy>1</min-redundancy>
        <documents>
            <document type="opencrawling_chunk" mode="index"/>
            <document type="opencrawling_chunk_384" mode="index"/>
            <document type="opencrawling_chunk_768" mode="index"/>
            <document type="opencrawling_chunk_1024" mode="index"/>
        </documents>
        <nodes>
            <node hostalias="node1" distribution-key="0"/>
        </nodes>
        <tuning>
            <resource-limits>
                <disk>0.999</disk>
            </resource-limits>
        </tuning>
    </content>

</services>
