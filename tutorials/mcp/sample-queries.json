{
  "notes": [
    "Use these argument payloads in MCP Inspector (Web UI or --cli mode) against http://localhost:8080/mcp.",
    "Because Alfresco prefixes group authorities with GROUP_, pass GROUP_finance / GROUP_engineering in userRoles.",
    "For listAccessibleSources, pass dimensions: 1024 to query vector_store_1024 only (when Admin UI jobs run against a decoupled stack, VectorOutputConnector also writes to vector_store while consumers write to vector_store_1024). For secureVectorSearch, omitting dimensions automatically selects vector_store_1024 from the 1024-d query vector."
  ],
  "personas": {
    "guest_public_only": {
      "listAccessibleSources": {
        "userPrincipal": "guest",
        "userRoles": "",
        "dimensions": 1024
      },
      "secureVectorSearch": {
        "query": "ACME budget architecture handbook",
        "userPrincipal": "guest",
        "userRoles": "",
        "maxResults": 10,
        "minScore": 0.0
      }
    },
    "charlie_finance": {
